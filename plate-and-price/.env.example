# Copy to .env (git-ignored). Real keys never go in this file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Image generation (scripts/make_cover_ai.py, config/cover_ai.json): OpenAI is the image provider for the next videos.
